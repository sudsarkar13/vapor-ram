__pycache__/
*.pyc
*.o
*.so
*.egg-info/

# Compiled C engine output. These are build artifacts: setup.py runs
# `make -C c` at install time and MANIFEST.in ships the sources, so a
# committed binary only served to push one host's architecture at every
# other host. They were tracked until v1.0.7; `git rm --cached` fixed it.
c/vapor_engine
c/simd_bench
.DS_Store
models/
*.gguf
*.bin
*.safetensors

# Python build output at the repo root only.
# NOTE: these are anchored with a leading slash on purpose. A bare `dist/`
# also matched web/dist/, which silently excluded the compiled dashboard
# assets from the repo — releases then shipped an index.html with no JS.
/dist/
/build/
/dist_build/

# Node / Next.js
node_modules/
.next/
.yarn/
*.tsbuildinfo

# The static dashboard export IS committed: the Python package serves it
# directly, so it must be present in a clean checkout.
!web/dist/
!web/dist/**

# OS distribution archives (attached to GitHub Releases, excluded from git repo)
vapor-ram-v*.tar.gz
vapor-ram-v*.zip
.venv/

# Runtime assets staged into the package at build time (see setup.py)
vapor_ram/web/
vapor_ram/presets/
vapor_ram/tools/
vapor_ram/c/

# Runtime configuration, written by the server whenever a setting changes.
# Tracked until v1.0.7, where it repeatedly reset users' own settings.
# vapor.example.json is the tracked reference copy.
vapor.json
